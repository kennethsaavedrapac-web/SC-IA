# Variables de Entorno - Salud-Conecta IA
# Copia este archivo como .env y completa los valores

# --- SUPABASE ---
# URL de tu proyecto Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Anon key pública de Supabase (segura para frontend)
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_aqui
# Service role key (requerida en produccion; solo servidor, nunca usar prefijo VITE_)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- CARTO BASEMAPS ---
# API Key publica para los mapas base de CARTO (opcional; restringir por dominio en CARTO)
VITE_CARTO_API_KEY=tu_carto_api_key_aqui

# --- GEMINI AI ---
# API Key de Google Gemini AI (requerida en produccion; solo servidor)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# --- WEB PUSH (Service Worker Notifications) ---
# Clave pública VAPID para notificaciones push
VITE_VAPID_PUBLIC_KEY=tu_vapid_public_key_aqui
# Clave privada VAPID (mantener en secreto en el servidor)
VAPID_PRIVATE_KEY=tu_vapid_private_key_aqui
# Email de contacto para VAPID (opcional; por defecto mailto:soporte@salud-conecta.com)
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# --- FRONTEND (CORS) ---
# Origen publico exacto del frontend; en Azure debe coincidir con el dominio HTTPS
FRONTEND_URL=http://localhost:3000

# --- CRON (requerido si se despliega api/cron-notifications.js) ---
# Secreto largo y aleatorio para autorizar tareas programadas; solo servidor
CRON_SECRET=tu_cron_secret_aqui

# --- ENVIRONMENT ---
# Define el entorno de ejecución (development o production)
NODE_ENV=development
